# PostgreSQL (local dev cluster on port 5434 (data dir outside the repo, see backend/.env comments); create the DB + role with
# `python scripts/create_db.py --admin-url postgresql://postgres:ADMIN_PASS@localhost:5434/postgres --password APP_PASS`)
DATABASE_URL=postgresql+psycopg://recipe_user:APP_PASS@localhost:5434/recipe_manager
CORS_ORIGINS=http://localhost:4200
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Recipe cache (optional; docker compose up -d redis). The API still works if Redis is down;
# leave empty to disable the cache entirely.
REDIS_URL=redis://localhost:6380/0

# From your Cloudinary dashboard (cloudinary.com) - free tier, no card required
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
