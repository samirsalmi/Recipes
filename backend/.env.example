DATABASE_URL=mysql+pymysql://recipe_user:recipe_pass@localhost:3306/recipe_manager
CORS_ORIGINS=http://localhost:4200
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Recipe cache (docker compose up -d redis); the API still works if Redis is down
REDIS_URL=redis://localhost:6380/0

# From your Cloudinary dashboard (cloudinary.com) - free tier, no card required
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
