{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/recipe-manager/browser",
  "env": {
    "NODE_OPTIONS": "--max_old_space_size=4096"
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|[^/]*[.][^/]*).*)", "destination": "/index.html" }
  ]
}
